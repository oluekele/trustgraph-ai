# ---------------------------------------------------------------------------
# TrustGraph AI — root environment (Python governance engine + docker compose)
# Copy to .env and replace every secret. Never commit .env.
# ---------------------------------------------------------------------------

# Shared secret: NestJS gateway -> Python governance API (X-Service-Token).
TRUSTGRAPH_SERVICE_TOKEN=replace-with-a-long-random-string
# HMAC key for single-use tool execution tickets.
TRUSTGRAPH_TICKET_SECRET=replace-with-another-long-random-string
# NestJS session signing key (min 16 chars).
JWT_SECRET=replace-with-a-third-long-random-string-for-trustgraph

POSTGRES_PASSWORD=Applying
NEO4J_PASSWORD=trustgraph-neo4j

# --- Local (non-docker) Python development ---
# Defaults to SQLite at ./trustgraph.db when unset.
TRUSTGRAPH_DATABASE_URL=postgresql://trustgraph:Applying@localhost:5432/trustgraph
TRUSTGRAPH_SEED_ON_STARTUP=true
TRUSTGRAPH_APPROVAL_TTL_MINUTES=30
TRUSTGRAPH_NEO4J_ENABLED=false
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j

# --- Optional LLM planners (the agent console falls back to a local planner) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# Host port for compose PostgreSQL (change if 5432 is taken locally)
POSTGRES_PORT=5432
