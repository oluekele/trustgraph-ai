# ---------------------------------------------------------------------------
# TrustGraph AI governance gateway (NestJS) - environment variables
# ---------------------------------------------------------------------------

# Runtime: development | production | test. In production JWT_SECRET is required,
# cookies are Secure and demo operator accounts are not seeded.
NODE_ENV=development
# HTTP port (API under /api, Swagger UI under /docs).
PORT=3001

# Comma-separated list of browser origins allowed by CORS (credentials enabled).
FRONTEND_ORIGIN=http://localhost:3000
# Set true when running behind a reverse proxy so client IPs (rate limit, login events) are correct.
TRUST_PROXY=false

# --- Database (PostgreSQL; gateway manages only `operators`, `login_events`, `gateway_migrations`) ---
DATABASE_URL=postgres://trustgraph:Applying@localhost:5432/trustgraph
# Apply gateway migrations on startup (default true).
DB_MIGRATIONS_RUN=true
# TypeORM schema synchronize - local experimentation only (default false; migrations are the source of truth).
DB_SYNCHRONIZE=false

# --- Operator authentication ---
# HMAC secret for session JWTs (min 16 chars). REQUIRED when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime (cookie max-age is 8h).
JWT_EXPIRES_IN=8h
# Max login attempts per IP per minute.
LOGIN_RATE_LIMIT=10

# Initial admin, created only when the operators table is empty.
ADMIN_EMAIL=admin@trustgraph.local
ADMIN_PASSWORD=TrustGraph!2026
# Seed operator@/approver@/auditor@trustgraph.local (password TrustGraph!2026). Default: true outside production.
SEED_DEMO_USERS=true

# --- Python governance engine (authoritative) ---
TRUSTGRAPH_API_URL=http://localhost:8000
# Shared secret sent as X-Service-Token; must equal the Python service's TRUSTGRAPH_SERVICE_TOKEN.
TRUSTGRAPH_SERVICE_TOKEN=dev-service-token
# Request timeout (ms) for engine calls, and for /evaluation/run and /agents/{id}/run.
TRUSTGRAPH_TIMEOUT_MS=10000
TRUSTGRAPH_LONG_TIMEOUT_MS=120000
